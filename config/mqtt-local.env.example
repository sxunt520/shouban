# Explicitly isolated development profile. Copy to .env.mqtt.local at project root.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=shouban_mqtt_dev
DB_SYNCHRONIZE=true

PARTNER_MQTT_ENABLED=true
PARTNER_MQTT_URL=mqtt://127.0.0.1:18883
PARTNER_MQTT_USERNAME=local-cloud
PARTNER_MQTT_PASSWORD=local-cloud-only
PARTNER_MQTT_TOPIC_PREFIX=shouban/dev/v1
PARTNER_MQTT_COMMAND_TIMEOUT_MS=15000
PARTNER_MQTT_RETRY_MS=2000
PARTNER_MQTT_PRESENCE_TIMEOUT_MS=30000
MQTT_SIMULATOR_FIXTURES=true

# Local broker is loopback-only. Credentials here are public development values.
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=18883
