# Mobile: use the computer's LAN IP when running on a real phone.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/v1

# API
PORT=3000
DEVICE_ONLINE_WINDOW_SECONDS=45
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=figure_companion
# Development only. Use migrations and set this to false in production.
DB_SYNCHRONIZE=true

# Alibaba Cloud NLS: one-sentence speech recognition (ASR).
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_TOKEN_ENDPOINT=https://nls-meta.cn-shanghai.aliyuncs.com
ALIYUN_NLS_ASR_ENDPOINT=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/asr
ALIYUN_NLS_REALTIME_ENDPOINT=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1
ALIYUN_NLS_ASR_MAX_SENTENCE_SILENCE_MS=500
ALIYUN_NLS_ASR_FINAL_TIMEOUT_MS=5000

# Alibaba Cloud Model Studio (DashScope): CosyVoice voice-cloning TTS.
DASHSCOPE_API_KEY=
DASHSCOPE_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
DASHSCOPE_TTS_WS_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_TTS_REALTIME_ENABLED=true
DASHSCOPE_TTS_LEADING_ARTIFACT_FILTER=true
# Learn per cloned voice: 300ms initially, 240ms after clean turns, and
# automatically return to 350ms protection after detecting a leading artifact.
DASHSCOPE_TTS_LEADING_ARTIFACT_ADAPTIVE=true
# Keep an idle realtime TTS WebSocket for reuse between nearby conversation turns.
DASHSCOPE_TTS_WS_POOL_IDLE_MS=60000
DASHSCOPE_TTS_MODEL=cosyvoice-v3.5-plus
DASHSCOPE_TTS_FORMAT=wav
DASHSCOPE_TTS_SAMPLE_RATE=24000
DASHSCOPE_TTS_DEFAULT_VOICE=cosyvoice-v3.5-plus-bailian-0a1de96cb4df4508b7ff0ef9d661a963

# 腾讯云对象存储配置
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_PREFIX=jh_chat/fishing
SYNCHRONIZE=true

# MiniMax chat completion.
AI_API_KEY=
AI_API_URL=https://api.minimaxi.com/v1
AI_MODEL=M2-her
AI_MAX_COMPLETION_TOKENS=300
AI_TEMPERATURE=1
